<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 6: 学生証（FeliCa）の読み取り。
      読むのは画面を開いている間だけ（enableReaderMode）。
      バックグラウンドでタグを拾う intent-filter は意図的に付けない。
      NFC の無い端末でもインストールできるよう required="false"。
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_vector"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusPlanPoc"
        android:usesCleartextTraffic="false">
        <!--
          セキュリティ上の要点:
          - usesCleartextTraffic="false": 平文 HTTP を OS レベルで禁止（network_security_config でも二重に禁止）
          - allowBackup="false" / dataExtractionRules: WebView の Cookie / セッションが
            端末バックアップやデバイス間転送で外部へ出ないようにする
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <!--
              configChanges を指定して回転時に Activity を再生成させない。
              WebView を破棄せずに済むため、ログイン済みセッションと画面状態が維持される。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              共用タブレットをこのアプリ専用機にするため、ホームアプリとしても
              名乗れるようにする。既定にするかは利用者（または Device Owner）が決める。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          端末専用モード（Dedicated Device）用の受け口。
          adb shell dpm set-device-owner で Device Owner に設定したときだけ効く。
          設定していない端末では何も起きない。
        -->
        <receiver
            android:name=".kiosk.PortalDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
